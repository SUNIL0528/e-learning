# Copy to client/.env.production before npm run build:aws.
# These are public build-time values, not secrets.
VITE_API_URL=https://api.example.com
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-public-app-client-id
VITE_COGNITO_INSTRUCTOR_GROUP=instructors
VITE_COGNITO_ADMIN_GROUP=admins
VITE_LOCAL_DEV=false
# Explicitly clear any direct-S3 values inherited from client/.env.
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_S3_BUCKET=
VITE_S3_REGION=
