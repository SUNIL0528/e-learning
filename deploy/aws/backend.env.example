# Copy to /etc/hts/backend.env on EC2. Keep secrets in Secrets Manager.
HTS_AWS_PRODUCTION=true
HTS_ENABLE_PPT_TRANSLATION=false
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://learn.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
AWS_REGION=ap-south-1
AWS_SECRETS_MANAGER_SECRET_ID=hts/prod/backend
AWS_S3_BUCKET=your-private-media-bucket
POSTGRES_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-public-app-client-id
COGNITO_INSTRUCTOR_GROUP=instructors
COGNITO_ADMIN_GROUP=admins
