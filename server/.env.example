DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=database-1
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
# Keep RDS connections open briefly to avoid reconnecting for every API request.
POSTGRES_CONN_MAX_AGE=60
USE_SQLITE=false

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Cognito group allowed to read and answer all learner doubts.
COGNITO_INSTRUCTOR_GROUP=instructors

AWS_REGION=us-east-1
AWS_S3_BUCKET=coating-and-inspection
AWS_S3_URL_EXPIRY=3600
AWS_S3_UPLOAD_URL_EXPIRY=900
# Use either AWS credentials here for local testing, an AWS profile, or an IAM role in AWS.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
